# Optional upstream proxy (squid): all egress, model requests included, goes through a domain whitelist.
# Comment out this line to run without the proxy (egress controlled by the OpenShell policy only).
COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml

# Pin the gateway and the CLI to the SAME OpenShell version (this setup needs 0.1.x).
OPENSHELL_GATEWAY_TAG=0.1.5
# CLI release from GitHub (the openshell package on PyPI has no CLI); empty = latest release.
OPENSHELL_CLI_VERSION=0.1.5

# docker0 bridge IP (ip -4 addr show docker0). With the proxy it must match https_proxy in openshell/gateway.proxy.toml.
HOST_BRIDGE_IP=172.17.0.1

# Hermes tag/commit (NousResearch/hermes-agent) — pin it instead of main.
HERMES_REF=main

# Model backend: any OpenAI-compatible API (vLLM, OpenRouter, NIM...). Hermes calls it directly.
# The key goes to the OpenShell provider; the sandbox gets only a placeholder in MODEL_API_KEY.
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=sk-change-me
MODEL_NAME=anthropic/claude-sonnet-4.5

SANDBOX_NAME=hermes
# Main sandbox process. "sleep infinity" = you work interactively (connect + hermes).
# With channels (Telegram/Slack) or the Hermes API server: "hermes gateway run".
HERMES_CMD=sleep infinity
