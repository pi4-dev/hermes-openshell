# Optional upstream proxy (squid): all egress, model requests included, goes through a domain whitelist.
# Comment out this line to run without the proxy (egress controlled by the OpenShell policy only).
COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml

# Agents: hermes, claude (Claude Code with a Claude subscription) or both side by side: hermes,claude.
# Compose builds and starts only the chosen agents' services; bootstrap creates their sandboxes.
COMPOSE_PROFILES=hermes

# Pin the gateway and the CLI to the SAME OpenShell version (this setup needs 0.1.x).
OPENSHELL_GATEWAY_TAG=0.1.5
# CLI release from GitHub (the openshell package on PyPI has no CLI); empty = latest release.
OPENSHELL_CLI_VERSION=0.1.5

# docker0 bridge IP (ip -4 addr show docker0). With the proxy it must match https_proxy in openshell/gateway.proxy.toml.
HOST_BRIDGE_IP=172.17.0.1

# --- Hermes ---
# Hermes tag/commit (NousResearch/hermes-agent) — pin it instead of main.
HERMES_REF=main

# Model backend: any OpenAI-compatible API (vLLM, OpenRouter, NIM...). Only the model-relay service
# gets these; Hermes knows just the relay (host.docker.internal:8082) and the model alias "assistant".
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=sk-change-me
MODEL_NAME=anthropic/claude-sonnet-4.5

SANDBOX_NAME=hermes
# Main sandbox process (what `openshell sandbox connect` attaches to). "sleep infinity" = only keeps
# the sandbox running; work with `openshell sandbox exec --tty hermes -- hermes`.
# With channels (Telegram/Slack) or the Hermes API server: "hermes gateway run".
# Web dashboard: "hermes dashboard --skip-build --no-open" (see README, Web dashboard).
HERMES_CMD=sleep infinity

# --- Claude Code ---
# Token from `claude setup-token` (Pro, Max, Team or Enterprise plan; see README). Only bootstrap
# reads it and stores it in the gateway; the sandbox gets a placeholder instead.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_SANDBOX_NAME=claude
