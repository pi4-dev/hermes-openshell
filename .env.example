# Przypnij gateway i CLI do TEJ SAMEJ wersji OpenShell.
OPENSHELL_GATEWAY_TAG=latest
OPENSHELL_CLI_VERSION=          # puste = najnowsze z PyPI; wpisz np. 0.1.5

# IP mostka docker0 (ip -4 addr show docker0). Musi się zgadzać z https_proxy w openshell/gateway.toml.
HOST_BRIDGE_IP=172.17.0.1
# getent group docker | cut -d: -f3
DOCKER_GID=999

# Tag/commit Hermesa (NousResearch/hermes-agent) — przypnij zamiast main.
HERMES_REF=main

# Backend modelu: dowolne API OpenAI-compatible (vLLM, OpenRouter, NIM...).
# Klucz trafia do providera OpenShell, NIE do sandboxa.
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=sk-change-me
MODEL_NAME=anthropic/claude-sonnet-4.5

SANDBOX_NAME=hermes
# Główny proces sandboxa. "sleep infinity" = pracujesz interaktywnie (connect + hermes).
# Z kanałami (Telegram/Slack) albo API servera Hermesa: "hermes gateway run".
HERMES_CMD=sleep infinity
